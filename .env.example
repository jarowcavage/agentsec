OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Enable isolated local interview console persona switching. Never expose publicly.
AGENTSEC_DEMO=0

# Optional publishing. One repository only. Draft PRs require Contents and Pull requests: read/write.
# The legacy issue adapter additionally requires Issues: write. Do not grant it unless needed.
AGENTSEC_GITHUB_REPOSITORIES=
# Legacy issue adapter target (optional):
AGENTSEC_GITHUB_REPOSITORY=
AGENTSEC_GITHUB_TOKEN=
# Separate strong password (at least 16 characters) for connected human approvals.
AGENTSEC_APPROVER_PASSWORD=
